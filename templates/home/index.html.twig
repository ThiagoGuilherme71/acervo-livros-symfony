{% extends 'base.html.twig' %}

{% block title %}Início{% endblock %}

{% block body %}
    <h2 class="mb-1">Início</h2>
    <p class="text-muted mb-4">Visão geral do acervo</p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase">Livros</small>
                    <h3 class="text-success mb-0">{{ totalLivros }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase">Autores</small>
                    <h3 class="text-success mb-0">{{ totalAutores }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase">Assuntos</small>
                    <h3 class="text-success mb-0">{{ totalAssuntos }}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <small class="text-muted text-uppercase">Acervo (R$)</small>
                    <h3 class="text-success mb-0">R$ {{ valorTotal|number_format(2, ',', '.') }}</h3>
                </div>
            </div>
        </div>
    </div>

    <h5 class="mb-3">Acesso rápido</h5>
    <div class="row g-3">
        <div class="col-md-6">
            <a href="{{ path('app_livro_index') }}" class="text-decoration-none">
                <div class="card h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-dark">Cadastro de Livros</h6>
                            <small class="text-muted">Título, editora, ano, valor</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('app_autor_index') }}" class="text-decoration-none">
                <div class="card h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-dark">Cadastro de Autores</h6>
                            <small class="text-muted">Nome e livros vinculados</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6">
            <a href="{{ path('app_assunto_index') }}" class="text-decoration-none">
                <div class="card h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-dark">Cadastro de Assuntos</h6>
                            <small class="text-muted">Descrição e livros vinculados</small>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                </div>
            </a>
        </div>
 
    </div>
{% endblock %}