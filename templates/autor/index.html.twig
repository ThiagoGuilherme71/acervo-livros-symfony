{% extends 'base.html.twig' %}

{% block title %}Autores{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Autores</h2>
        <a href="{{ path('app_autor_new') }}" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Novo autor
        </a>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table
                class="table table-hover align-middle mb-0"
                data-toggle="table"
                data-search="true"
                data-pagination="true"
                data-page-size="10"
                data-filter-control="true"
                data-show-search-clear-button="true"
                data-icon-size="sm"
                data-buttons-class="outline-secondary"
            >
                <thead class="table-light">
                    <tr>
                        <th data-field="id" data-sortable="true" data-width="90">Cód.</th>
                        <th data-field="nome" data-sortable="true" data-filter-control="input" data-filter-control-placeholder="Filtrar nome">Nome</th>
                        <th data-field="livros" data-filter-control="input" data-filter-control-placeholder="Filtrar livro" data-filter-custom-search="filtrarTexto">Livros vinculados</th>
                        <th data-field="acoes" class="text-end" data-width="110">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for autor in autores %}
                        <tr>
                            <td class="text-muted">{{ autor.id }}</td>
                            <td class="fw-semibold">{{ autor.nome }}</td>
                            <td>
                                {% for livro in autor.livros %}
                                    <span class="badge bg-success-subtle text-success-emphasis">{{ livro.titulo }}</span>
                                {% else %}
                                    <span class="text-muted small">Nenhum</span>
                                {% endfor %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_autor_edit', {id: autor.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form action="{{ path('app_autor_delete', {id: autor.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este autor?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-autor-' ~ autor.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}